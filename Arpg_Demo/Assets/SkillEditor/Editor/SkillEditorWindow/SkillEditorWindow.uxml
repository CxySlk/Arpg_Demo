<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/SkillEditor/Editor/SkillEditorWindow/SkillEditorWindow.uss?fileID=7433441132597879392&amp;guid=9b5841690fd6bbf469075b9260355db3&amp;type=3#SkillEditorWindow"/>
    <ui:VisualElement name="Top" style="flex-grow: 0; height: 50px; flex-shrink: 1; flex-direction: row; border-bottom-width: 0.5px; border-left-color: rgb(77, 77, 77); border-right-color: rgb(77, 77, 77); border-top-color: rgb(77, 77, 77); border-bottom-color: rgb(77, 77, 77);">
        <ui:Button text="技能编辑场景" name="btnSkillEditorScene" style="height: auto; width: 100px; font-size: 15px; -unity-font-style: bold; -unity-text-auto-size: none;"/>
        <ui:Button text="打开旧场景" name="btnOldScene" style="font-size: 15px; width: 100px; -unity-font-style: bold; -unity-text-auto-size: none;"/>
        <ui:Button text="配置信息" name="btnConfigInfo" style="font-size: 15px; width: 100px; -unity-font-style: bold; -unity-text-auto-size: none;"/>
        <uie:ObjectField label="演示角色预制体" name="previewPrefabField" enabled="true" style="flex-shrink: 1; flex-grow: 1; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 15px; height: auto; align-items: stretch; align-self: center;"/>
        <uie:ObjectField label="演示角色物体" name="previewObjectField" style="flex-shrink: 1; flex-grow: 1; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 15px; flex-wrap: wrap; align-self: center;"/>
        <uie:ObjectField label="技能配置" name="skillClipConfigField" style="flex-shrink: 1; flex-grow: 1; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 15px; align-self: center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="Content" style="flex-grow: 1; white-space: normal; flex-direction: row;">
        <ui:VisualElement name="ContentLeft" style="flex-grow: 0; flex-shrink: 0; width: 222px; border-right-width: 0.5px; border-left-color: rgb(77, 77, 77); border-right-color: rgb(77, 77, 77); border-top-color: rgb(77, 77, 77); border-bottom-color: rgb(77, 77, 77);">
            <ui:VisualElement name="Menu" style="flex-grow: 0; flex-direction: row; height: 35px; flex-shrink: 0; -unity-text-align: upper-left; flex-wrap: nowrap; justify-content: space-around; width: auto; align-content: flex-start; border-left-color: rgb(77, 77, 77); border-right-color: rgb(77, 77, 77); border-top-color: rgb(77, 77, 77); border-bottom-color: rgb(77, 77, 77); border-bottom-width: 0.5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                <ui:Button text="&lt;" name="btnPreviousFrame" style="width: 30px; font-size: 20px; -unity-font-style: bold; flex-direction: column; flex-wrap: nowrap; -unity-text-align: middle-center; height: 30px;"/>
                <ui:Button text="▶" name="btnPlay" style="width: 30px; font-size: 20px; -unity-font-style: bold; -unity-text-align: lower-center; height: 30px;"/>
                <ui:Button text="&gt;" name="btnNextFrame" style="width: 30px; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-right; height: 30px;"/>
                <ui:IntegerField label="" value="0" name="curFrameIndexField" readonly="false" language-direction="Inherit" emoji-fallback-support="true" style="width: 30px; -unity-text-align: middle-center; flex-direction: row; white-space: nowrap; height: 30px;"/>
                <ui:Label text="/" style="-unity-text-align: middle-center; font-size: 15px; -unity-font-style: bold;"/>
                <ui:IntegerField label="" value="999" name="totalFrameIndexField" style="width: 30px; height: 30px;"/>
            </ui:VisualElement>
            <ui:ScrollView name="leftScrollView" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" style="flex-grow: 1; flex-shrink: 1; height: auto; padding-bottom: 13px;">
                <ui:VisualElement name="leftListView" style="flex-grow: 0; height: auto; flex-shrink: 0;"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="ContentRight" style="flex-grow: 1;">
            <ui:IMGUIContainer name="timeShaft" style="flex-shrink: 0; height: 35px; border-bottom-width: 0.5px; border-left-color: rgb(77, 77, 77); border-right-color: rgb(77, 77, 77); border-top-color: rgb(77, 77, 77); border-bottom-color: rgb(77, 77, 77);"/>
            <ui:ScrollView name="rightScrollView" mode="VerticalAndHorizontal" horizontal-scroller-visibility="AlwaysVisible" vertical-scroller-visibility="AlwaysVisible" touch-scroll-type="Clamped" style="flex-shrink: 0; flex-grow: 1; height: auto;">
                <ui:VisualElement name="rightListView" style="flex-grow: 0; height: auto; width: 350px; flex-shrink: 0; align-items: stretch;"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
